{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "satisfactory-server values",
  "type": "object",
  "properties": {
    "image": {
      "type": "object",
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "nameOverride": { "type": "string" },
    "fullnameOverride": { "type": "string" },
    "puid": { "type": ["string", "integer"] },
    "pgid": { "type": ["string", "integer"] },
    "serviceAccount": {
      "type": "object",
      "properties": {
        "create": { "type": "boolean" },
        "name": { "type": "string" },
        "annotations": { "type": "object" },
        "automountServiceAccountToken": { "type": "boolean" }
      }
    },
    "server": {
      "type": "object",
      "properties": {
        "maxPlayers": { "type": "integer", "minimum": 1 },
        "maxTickRate": { "type": "integer", "minimum": 1 },
        "maxObjects": { "type": "integer", "minimum": 1 },
        "autosaveNum": { "type": "integer", "minimum": 1 },
        "serverStreaming": { "type": "boolean" },
        "disableSeasonalEvents": { "type": "boolean" },
        "skipUpdate": { "type": "boolean" },
        "timeout": { "type": "integer", "minimum": 1 },
        "multihome": { "type": "string" },
        "debug": { "type": "boolean" },
        "log": { "type": "boolean" },
        "vmOverride": { "type": "boolean" },
        "gamePort": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "messagingPort": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "beta": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "id": { "type": "string" },
            "key": { "type": "string" }
          }
        }
      }
    },
    "tls": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "existingSecret": { "type": "string" },
        "certKey": { "type": "string", "minLength": 1 },
        "keyKey": { "type": "string", "minLength": 1 }
      }
    },
    "extraEnv": { "type": "array" },
    "extraEnvFrom": { "type": "array" },
    "service": {
      "type": "object",
      "properties": {
        "type": { "enum": ["ClusterIP", "NodePort", "LoadBalancer"] },
        "annotations": { "type": "object" },
        "labels": { "type": "object" },
        "loadBalancerIP": { "type": "string" },
        "loadBalancerClass": { "type": "string" },
        "loadBalancerSourceRanges": { "type": "array", "items": { "type": "string" } },
        "externalTrafficPolicy": { "enum": ["Cluster", "Local"] },
        "ipFamilyPolicy": { "enum": ["", "SingleStack", "PreferDualStack", "RequireDualStack"] },
        "ipFamilies": { "type": "array", "items": { "enum": ["IPv4", "IPv6"] } },
        "externalIPs": { "type": "array", "items": { "type": "string" } },
        "nodePorts": {
          "type": "object",
          "properties": {
            "gameTcp": { "type": ["string", "integer"] },
            "gameUdp": { "type": ["string", "integer"] },
            "messaging": { "type": ["string", "integer"] }
          }
        },
        "extraPorts": { "type": "array" }
      }
    },
    "persistence": {
      "type": "object",
      "properties": {
        "config": { "$ref": "#/definitions/claim" },
        "gamefiles": {
          "allOf": [
            { "$ref": "#/definitions/claim" },
            {
              "type": "object",
              "properties": {
                "type": { "enum": ["pvc", "emptyDir"] },
                "emptyDir": {
                  "type": "object",
                  "properties": { "sizeLimit": { "type": "string" } }
                }
              }
            }
          ]
        }
      }
    },
    "podSecurityContext": {
      "type": "object",
      "properties": {
        "runAsUser": { "type": "integer", "minimum": 0 },
        "runAsGroup": { "type": "integer", "minimum": 0 },
        "runAsNonRoot": { "type": "boolean" },
        "fsGroup": { "type": "integer", "minimum": 0 },
        "fsGroupChangePolicy": { "enum": ["Always", "OnRootMismatch"] }
      }
    },
    "containerSecurityContext": { "type": "object" },
    "resources": { "type": "object" },
    "probes": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "enabled": { "type": "boolean" },
          "initialDelaySeconds": { "type": "integer", "minimum": 0 },
          "periodSeconds": { "type": "integer", "minimum": 1 },
          "timeoutSeconds": { "type": "integer", "minimum": 1 },
          "failureThreshold": { "type": "integer", "minimum": 1 },
          "successThreshold": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "allowedSourceRanges": { "type": "array", "items": { "type": "string" } },
        "egress": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "allowDNS": { "type": "boolean" },
            "allowedDestinations": { "type": "array", "items": { "type": "string" } },
            "exceptDestinations": { "type": "array", "items": { "type": "string" } }
          }
        },
        "extraIngress": { "type": "array" },
        "extraEgress": { "type": "array" }
      }
    },
    "podAnnotations": { "type": "object" },
    "podLabels": { "type": "object" },
    "nodeSelector": { "type": "object" },
    "tolerations": { "type": "array" },
    "affinity": { "type": "object" },
    "topologySpreadConstraints": { "type": "array" },
    "priorityClassName": { "type": "string" },
    "terminationGracePeriodSeconds": { "type": "integer", "minimum": 0 },
    "hostNetwork": { "type": "boolean" },
    "dnsPolicy": {
      "enum": ["", "ClusterFirst", "ClusterFirstWithHostNet", "Default", "None"]
    },
    "dnsConfig": { "type": "object" },
    "lifecycle": { "type": "object" },
    "initContainers": { "type": "array" },
    "sidecars": { "type": "array" },
    "extraVolumes": { "type": "array" },
    "extraVolumeMounts": { "type": "array" },
    "extraObjects": { "type": "array" },
    "imagePullSecrets": { "type": "array" }
  },
  "definitions": {
    "claim": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "existingClaim": { "type": "string" },
        "storageClass": { "type": "string" },
        "accessModes": {
          "type": "array",
          "items": { "enum": ["ReadWriteOnce", "ReadOnlyMany", "ReadWriteMany", "ReadWriteOncePod"] },
          "minItems": 1
        },
        "size": { "type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?(E|P|T|G|M|k|Ei|Pi|Ti|Gi|Mi|Ki)?$" },
        "annotations": { "type": "object" },
        "labels": { "type": "object" },
        "retain": { "type": "boolean" }
      }
    }
  }
}
